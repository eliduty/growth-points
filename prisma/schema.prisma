// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  PARENT
  CHILD
}

model User {
  id              String            @id @default(cuid())
  name            String
  password        String
  role            UserRole          @default(CHILD)
  currentPoints   Int               @default(0)
  totalPoints     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  taskCompletions TaskCompletion[]
  giftRedemptions GiftRedemption[]
  giftBoxes       GiftBox[]
}

model Task {
  id          String            @id @default(cuid())
  name        String
  points      Int
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  completions TaskCompletion[]
}

model TaskCompletion {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  completedAt DateTime @default(now())
  revoked   Boolean  @default(false)
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, completedAt])
}

model Gift {
  id            String            @id @default(cuid())
  name          String
  points        Int
  description   String?
  image         String?
  available     Boolean           @default(true)
  maxRedeemable Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  redemptions GiftRedemption[]
  giftBoxes   GiftBox[]
}

model GiftRedemption {
  id        String   @id @default(cuid())
  userId    String
  giftId    String
  pointsSpent Int
  redeemedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)
}

model GiftBox {
  id        String   @id @default(cuid())
  userId    String
  giftId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@unique([userId, giftId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
